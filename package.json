{
  "name": "@box4dev/validador-br",
  "version": "1.0.2",
  "description": "Biblioteca completa e moderna para validação de documentos e dados brasileiros.",
  "author": "Box4Dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/box4dev/validador-br.git"
  },
   "bugs": {
    "url": "https://github.com/box4dev/validador-br/issues"
  },
  "homepage": "https://github.com/box4dev/validador-br#readme",
  "keywords": [
    "validador",
    "validator",
    "validação",
    "validation",
    "cpf",
    "cnpj",
    "cnpj-alfanumerico",
    "cnh",
    "cns",
    "pis",
    "pasep",
    "titulo-eleitor",
    "certidao",
    "inscricao-estadual",
    "cartao-credito",
    "brasil",
    "brazil",
    "br",
    "isValid",
    "validate",
    "typescript"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/validador-br.cjs",
  "module": "./dist/validador-br.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/validador-br.js",
      "require": "./dist/validador-br.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run test",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "biome:lint": "biome lint --write",
    "biome:format": "biome format --write",
    "biome:check": "biome check --write",
    "biome:ci": "biome ci",
    "test": "node --import tsx --test --experimental-test-coverage src/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch src/**/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "@types/node": "^26.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.13.0",
      "onFail": "download"
    }
  }
}